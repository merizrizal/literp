meta {
  name: Capture-Order-Payment
  type: http
  seq: 29
}

post {
  url: http://{{host}}:{{port}}/api/v1/orders/{{salesOrderId}}/payments
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{paymentIdempotencyKey}}
}

body:json {
  {
    "paymentMethod": "CASH",
    "amount": 39.98,
    "transactionRef": "POS-CASH-0001"
  }
}

docs {
  operationId: capturePayment
  request: POST /api/v1/orders/{salesOrderId}/payments
  note: Attributed POS payments require the authenticated shift owner; CASH captures are net drawer inflow and cannot exceed the order's remaining balance. Context-less orders retain existing payment behavior.
}

settings {
  encodeUrl: true
  timeout: 0
}
