meta {
  name: Pos-Update-Terminal
  type: http
  seq: 40
}

patch {
  url: http://{{host}}:{{port}}/api/v1/pos/terminals/{{terminalId}}
  body: json
  auth: inherit
}

body:json {
  {
    "terminalCode": "{{updatedTerminalCode}}",
    "deviceName": "{{updatedDeviceName}}"
  }
}

docs {
  operationId: updatePosTerminal
  request: PATCH /api/v1/pos/terminals/{terminalId}
  status: Authenticated; updates terminal code/name only within the caller's authorized location scope.
}

settings {
  encodeUrl: true
  timeout: 0
}
