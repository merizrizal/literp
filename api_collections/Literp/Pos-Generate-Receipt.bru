meta {
  name: Pos-Generate-Receipt
  type: http
  seq: 47
}

post {
  url: http://{{host}}:{{port}}/api/v1/pos/orders/{{salesOrderId}}/receipts
  body: none
  auth: inherit
}

headers {
  Idempotency-Key: {{posGenerateReceiptIdempotencyKey}}
}

docs {
  operationId: generatePosReceipt
  request: POST /api/v1/pos/orders/{salesOrderId}/receipts
  status: Implemented (201); issues one immutable receipt for a fulfilled attributed POS order.
  Requires a human issuer, the order-location grant, and exact payment settlement; the original shift may be closed.
  The same key replays the original response. A different key after issuance returns 409.
  Internal local receipt only; no tax/fiscal document, printing or external delivery is claimed.
}

settings {
  encodeUrl: true
  timeout: 0
}
